{
  "id": "08_token_refresh",
  "version": "1.0",
  "domain": "authentication",
  "method": "POST",
  "path": "/api/v1/auth/refresh",
  "description": "Exchange a valid refresh token for a new access/refresh token pair.",
  "bug_count": { "simple": 1, "moderate": 1, "complex": 2, "total": 4 },
  "schema": {
    "type": "object",
    "required": ["refresh_token", "client_id"],
    "properties": {
      "refresh_token": { "type": "string", "description": "The refresh token issued during login" },
      "client_id": { "type": "string", "description": "Client application identifier" },
      "device_id": { "type": "string", "description": "Optional device identifier; if provided, must match the device the token was issued to" }
    }
  },
  "sample_payload": {
    "refresh_token": "eyJhbGciOiJIUzI1NiJ9.refresh.abc123",
    "client_id": "app_web_v2",
    "device_id": "dev_a1b2c3"
  }
}
